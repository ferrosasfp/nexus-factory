# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Server-only. Used to write wallet addresses after signature verification.
# NEVER expose it to the client (no NEXT_PUBLIC_ prefix).
SUPABASE_SERVICE_ROLE_KEY=

# i18n (optional - defaults to 'en')
NEXT_PUBLIC_DEFAULT_LOCALE=en

# Web3 (solo hybrid) - EVM Agnostic, Avalanche por defecto
NEXT_PUBLIC_DEFAULT_NETWORK=avalanche
NEXT_PUBLIC_RPC_MAINNET=https://api.avax.network/ext/bc/C/rpc
NEXT_PUBLIC_RPC_TESTNET=https://api.avax-test.network/ext/bc/C/rpc
NEXT_PUBLIC_ALCHEMY_API_KEY=

# Account Abstraction (ERC-4337) - Pimlico
# Free: 1M credits/month, no card required
# Create at: https://dashboard.pimlico.io
NEXT_PUBLIC_BUNDLER_URL=
NEXT_PUBLIC_PAYMASTER_URL=

# Storage Descentralizado (solo hybrid)
STORAGE_PROVIDER=pinata
PINATA_JWT=
NEXT_PUBLIC_STORAGE_GATEWAY=

# ─── Sentry — Error Tracking ────────────────────────────────────────────────
# Obtener en: https://sentry.io → Settings → Projects → [proyecto] → Client Keys
# Inicialización condicional: si no está definido, Sentry se deshabilita (no rompe dev)
NEXT_PUBLIC_SENTRY_DSN=

# Auth token para subir source maps en build (CI/CD)
# Obtener en: https://sentry.io/settings/account/api/auth-tokens/
# Scope requerido: project:releases, org:read
SENTRY_AUTH_TOKEN=

# Organización en sentry.io (slug, ej: "mi-empresa")
SENTRY_ORG=

# Proyecto en sentry.io (slug, ej: "nexus-factory")
SENTRY_PROJECT=

# ─── Upstash Redis — Rate Limiting ──────────────────────────────────────────
# Obtener en: https://console.upstash.com → Redis → [database] → REST API
# Si no está configurado, el rate limiting pasa siempre (graceful degradation)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
